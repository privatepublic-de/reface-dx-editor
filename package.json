{
  "name": "reface-dx-editor",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite --port 5185 --strictPort",
    "probe": "vite --port 5185 --strictPort --open /probe.html",
    "start": "npm run build && vite preview --port 5185 --strictPort --open",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc",
    "list-voices": "vite-node tools/listVoices.ts --"
  },
  "author": "Peter Witzel",
  "license": "MIT",
  "description": "Voice editor and librarian for the Yamaha reface DX over Web MIDI",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  }
}
